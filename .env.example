# NextAuth v5 — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console → OAuth 2.0 Client IDs)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Editor de la hoja de estandarización de eventos (/admin/eventos) ---
# ID de la hoja de Google Sheets (el segmento entre /d/ y /edit de la URL).
EVENTOS_SHEET_ID=
# Opcional: rango/pestaña a editar. Debe empezar en A1. Ej: "Hoja1" o "Hoja1!A1:Z500".
# Si se omite, se usa la primera pestaña completa.
# EVENTOS_SHEET_RANGE=
# Opcional: JSON del service account CON permiso de escritura sobre la hoja
# (scope spreadsheets). Si se omite, cae a BIGQUERY_SERVICE_ACCOUNT.
# La hoja debe estar compartida como EDITOR con el email de este SA.
# SHEETS_SERVICE_ACCOUNT=
# JSON del SA con escritura en BigQuery (bqaccess@), SOLO para el botón
# "Sincronizar a BigQuery" de /admin/eventos. Debe tener dataEditor en el dataset
# glovox + jobUser. Si la query lee una tabla externa sobre el Sheet, compartir
# el Sheet (Viewer) con este SA.
# BIGQUERY_SYNC_SERVICE_ACCOUNT=

# --- Exportar reportes a Google Docs (/reportes/grid-kiki-jw) ---
# Los service accounts no tienen almacenamiento propio en Drive: crea una
# carpeta dentro de una Unidad Compartida, compártela como "Gestor de
# contenido" con el email del service account y pega acá el ID de la carpeta
# (el segmento final de la URL de la carpeta en Drive).
# GOOGLE_DRIVE_FOLDER_ID=

# Per-dashboard access is configured in lib/access.ts.
# These vars are kept for backwards reference only and are no longer read.
# ALLOWED_DOMAIN=
# ALLOWED_EMAILS=

# DASHBOARD_PERMISSIONS — per-user dashboard access. JSON. Three accepted shapes:
#   "user@glovox.cl": "all"                                  → unrestricted
#   "user@glovox.cl": ["/marketing/weekly"]                  → only listed prefixes
#   "user@glovox.cl": {                                      → scoped data access
#     "dashboards": ["/marketing/weekly"],
#     "dataScopes": {
#       "/marketing/weekly": { "ticketera": ["TeleTicket"] }
#     }
#   }
# DASHBOARD_PERMISSIONS={"admin@glovox.cl":"all","mkt-pe@glovox.cl":{"dashboards":["/marketing/weekly"],"dataScopes":{"/marketing/weekly":{"ticketera":["TeleTicket"]}}}}
