# NextAuth v5 — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console → OAuth 2.0 Client IDs)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Per-dashboard access is configured in lib/access.ts.
# These vars are kept for backwards reference only and are no longer read.
# ALLOWED_DOMAIN=
# ALLOWED_EMAILS=

# DASHBOARD_PERMISSIONS — per-user dashboard access. JSON. Three accepted shapes:
#   "user@glovox.cl": "all"                                  → unrestricted
#   "user@glovox.cl": ["/marketing/weekly"]                  → only listed prefixes
#   "user@glovox.cl": {                                      → scoped data access
#     "dashboards": ["/marketing/weekly"],
#     "dataScopes": {
#       "/marketing/weekly": { "ticketera": ["TeleTicket"] }
#     }
#   }
# DASHBOARD_PERMISSIONS={"admin@glovox.cl":"all","mkt-pe@glovox.cl":{"dashboards":["/marketing/weekly"],"dataScopes":{"/marketing/weekly":{"ticketera":["TeleTicket"]}}}}
