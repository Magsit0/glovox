{
  "name": "glovox-data",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate:preflight": "dotenv -e .env.local -- node db/preflight-migrate.cjs __drizzle_migrations_data",
    "db:migrate": "npm run db:migrate:preflight && dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "echo '⛔ push prohibido: la BD Neon es compartida con glovox-operaciones y push dropearia columnas del otro proyecto (p.ej. insumos_catalogo.tipo). Usa db:generate + db:migrate.' && exit 1",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx db/seed.ts",
    "db:normalize-marcas": "dotenv -e .env.local -- tsx db/scripts/normalize-marca-clientes.ts",
    "bq:seed-nombres": "dotenv -e .env.local -- tsx scripts/seed-nombres-genero.ts",
    "test:optimizer": "tsx lib/ticketing-pricing/optimizer.checks.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/bigquery": "^8.1.1",
    "@googleapis/drive": "^20.2.0",
    "@googleapis/sheets": "^13.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@types/chroma-js": "^3.1.2",
    "@xyflow/react": "^12.11.0",
    "ai": "^6.0.192",
    "chroma-js": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.30",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
